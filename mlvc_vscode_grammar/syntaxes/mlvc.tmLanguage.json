{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "mlvc",
	"patterns": [
		{
			"name": "comment.block.mlvc",
			"begin": "\\/\\*",
			"end": "\\*\\/"
		},
		{
			"name": "meta.embedded.block.mlvs",
			"begin": "\\b(asm)\\s*(\\{)",
			"beginCaptures": {
				"1": { "name": "keyword.control.mlvc" },
				"2": { "name": "keyword.operator.mlvc" }
			},
			"end": "\\}",
			"endCaptures": {
				"0": { "name": "keyword.operator.mlvc" }
			},
			"patterns": [
				{
					"name": "keyword.operator.address.mlvc",
					"match": "@([a-zA-Z\\_]+[a-zA-Z0-9\\_]*)"
				},
				{
					"name": "entity.name.function.preprocessor.mlvc",
					"match": "#([a-zA-Z\\_]+[a-zA-Z0-9\\_]*)"
				},
				{
					"include": "source.mlvs"
				}
			]
		},
		{
			"name": "keyword.control.mlvc",
			"match": "\\b(if|else|return|rti|while|set|define|macro|include|begin|fn|var|array|data|struct|call|asm|incr|decr|svi|ldi)\\b"
		},
		{
			"name": "string.quoted.double.mlvc",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{ "name": "constant.character.escape.mlvc", "match": "\\\\." }
			]
		},
		{
			"name": "string.quoted.single.mlvc",
			"begin": "'",
			"end": "'",
			"patterns": [
				{ "name": "constant.character.escape.mlvc", "match": "\\\\." }
			]
		},
		{
			"name": "storage.type.mlvc",
			"match": "\\b(u8|u16|i8|i16)\\b"
		},
		{
			"name": "entity.name.function.preprocessor.mlvc",
			"match": "#([a-zA-Z\\_]+[a-zA-Z0-9\\_]*)"
		},
		{
			"name": "keyword.operator.address.mlvc",
			"match": "@([a-zA-Z\\_]+[a-zA-Z0-9\\_]*)"
		},
		{
			"name": "keyword.operator.mlvc",
			"match": "(\\=\\=|\\!\\=|\\>\\=|\\<\\=|\\=|\\>\\>|\\<\\<|\\>|\\<|\\+|\\-|\\*|\\(|\\)|\\[|\\]|\\&\\&|\\&|\\||\\^|\\~|\\#|\\@|\\!|\\?|\\,|\\;|\\%|\\/)"
		},
		{
			"name": "constant.numeric.mlvc",
			"match": "(0x[0-9A-Fa-f]+|0b[01]+|-?[0-9]+)"
		},
		{
			"match": "\\?([a-zA-Z\\_]+[a-zA-Z0-9\\_]*)",
				"name": "support.function.builtin.mlvc"
			},
			{
				"match": "call\\s+([a-zA-Z\\_]+[a-zA-Z0-9\\_]*)",
			"name": "support.function.builtin.mlvc"
		},
		{
			"name": "variable.other.readwrite.mlvc",
			"match": "([a-zA-Z\\_]+[a-zA-Z0-9\\_]*)"
		}
	],
	"scopeName": "source.mlvc"
}
