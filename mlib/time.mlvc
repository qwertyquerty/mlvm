include mlib/interrupt.mlvc;

define ML_TIME_MS_REG 0x6100;
define ML_TIME_US_REG 0x6102;
define ML_TIME_IRQ1_INTERVAL_REG 0x6104;
define ML_TIME_IRQ2_INTERVAL_REG 0x6105;
define ML_TIME_RESET_REG 0x610F;

define ML_TIME_IRQ1_ID 0x10;
define ML_TIME_IRQ2_ID 0x11;

var u16 ml_time_ms @ #ML_TIME_MS_REG;
var u16 ml_time_us @ #ML_TIME_US_REG;

/* Installs HANDLER_ADDR and arms timer 1 to fire that IRQ every INTERVAL_MS. */
macro ML_TIME_REGISTER_IRQ1(HANDLER_ADDR, INTERVAL_MS) {
    #ML_INT_REGISTER_IRQ(#ML_TIME_IRQ1_ID, #HANDLER_ADDR);
    set [#ML_TIME_IRQ1_INTERVAL_REG] = #INTERVAL_MS;
}

/* Installs HANDLER_ADDR and arms timer 2 to fire that IRQ every INTERVAL_MS. */
macro ML_TIME_REGISTER_IRQ2(HANDLER_ADDR, INTERVAL_MS) {
    #ML_INT_REGISTER_IRQ(#ML_TIME_IRQ2_ID, #HANDLER_ADDR);
    set [#ML_TIME_IRQ2_INTERVAL_REG] = #INTERVAL_MS;
}

/* Busy-waits until n milliseconds have passed. Resets the timer first, so callers don't need to. */
fn ml_time_delay_ms(u16 n) {
    set [#ML_TIME_RESET_REG] = 0;
    while (ml_time_ms < n) {
    }
}

/* Busy-waits until n microseconds have passed. Resets the timer first, so callers don't need to. */
fn ml_time_delay_us(u16 n) {
    set [#ML_TIME_RESET_REG] = 0;
    while (ml_time_us < n) {
    }
}

/* Resets the ms/us counters back to 0. */
fn ml_time_reset {
    set [#ML_TIME_RESET_REG] = 0;
}
